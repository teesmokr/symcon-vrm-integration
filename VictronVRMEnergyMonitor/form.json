{
    "elements": [
        {
            "type": "Select",
            "name": "DataSource",
            "caption": "Data source",
            "options": [
                {
                    "caption": "VRM Cloud (access token)",
                    "value": 0
                },
                {
                    "caption": "MQTT (local, Cerbo/Venus) – beta",
                    "value": 1
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "VRM access",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "For 'VRM Cloud': create a personal access token in the VRM portal under Preferences → Integrations → Access tokens."
                },
                {
                    "type": "PasswordTextBox",
                    "name": "AccessToken",
                    "caption": "Access token"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Load installations",
                            "onClick": "VRM_LoadInstallations($id);"
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "IdSite",
                    "caption": "Installation",
                    "options": [
                        {
                            "caption": "Please load installations",
                            "value": 0
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "MQTT (local) – beta",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "For 'MQTT': enable MQTT on the Cerbo GX / Venus OS (Settings → Services → MQTT). The module polls the local broker on each update. Note: MQTT support is beta and has not been tested against a live broker yet – please report back."
                },
                {
                    "type": "ValidationTextBox",
                    "name": "MqttHost",
                    "caption": "Host / IP"
                },
                {
                    "type": "NumberSpinner",
                    "name": "MqttPort",
                    "caption": "Port",
                    "minimum": 1,
                    "maximum": 65535
                },
                {
                    "type": "ValidationTextBox",
                    "name": "MqttUser",
                    "caption": "Username (optional)"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "MqttPassword",
                    "caption": "Password (optional)"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "MqttPortalId",
                    "caption": "Portal ID (optional, auto-detected if empty)"
                },
                {
                    "type": "Button",
                    "caption": "Test MQTT connection",
                    "onClick": "VRM_TestMqtt($id);"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Update",
            "expanded": true,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "UpdateInterval",
                    "caption": "Update interval",
                    "suffix": "seconds",
                    "minimum": 5,
                    "maximum": 3600
                },
                {
                    "type": "Label",
                    "caption": "Note: The VRM cloud updates the stored values only every few minutes. MQTT is near real-time, so a short interval (e.g. 5–10 s) makes sense there."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Display / utilization bars",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "The arcs show a 0–100 % utilization bar. Enter the rated power (W) that equals 100 % for each."
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaxPV",
                    "caption": "Solar 100 % at (W)",
                    "minimum": 0
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaxGrid",
                    "caption": "Grid 100 % at (W)",
                    "minimum": 0
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaxConsumption",
                    "caption": "AC consumption 100 % at (W)",
                    "minimum": 0
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaxDC",
                    "caption": "DC loads 100 % at (W)",
                    "minimum": 0
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Second consumer (e.g. heat pump)",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Show an additional consumer at the bottom of the tile, read from any Symcon variable (W)."
                },
                {
                    "type": "CheckBox",
                    "name": "ExtraEnabled",
                    "caption": "Show second consumer"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "ExtraName",
                    "caption": "Label"
                },
                {
                    "type": "SelectVariable",
                    "name": "ExtraVariable",
                    "caption": "Power variable (W)"
                },
                {
                    "type": "NumberSpinner",
                    "name": "ExtraMax",
                    "caption": "100 % at (W)",
                    "minimum": 0
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Value mapping (advanced, VRM)",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "VRM only: values are detected automatically. If a value stays 0 or is wrong, use 'List available codes', find the correct code(s) and enter them below. Multiple codes are summed (comma separated), e.g. per phase."
                },
                {
                    "type": "Button",
                    "caption": "List available codes",
                    "onClick": "VRM_ListCodes($id);"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodeSOC",
                    "caption": "Code battery charge (SOC)"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodeBatteryVoltage",
                    "caption": "Code battery voltage"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodeBattery",
                    "caption": "Code(s) battery power"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodePV",
                    "caption": "Code(s) solar power"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodeGrid",
                    "caption": "Code(s) grid power (per phase e.g. g1,g2,g3)"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodeConsumption",
                    "caption": "Code(s) AC consumption (per phase e.g. o1,o2,o3)"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodeDC",
                    "caption": "Code(s) DC loads"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Update now",
            "onClick": "VRM_Update($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Active"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Inactive – configure the selected data source"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Communication error with the data source"
        }
    ]
}
