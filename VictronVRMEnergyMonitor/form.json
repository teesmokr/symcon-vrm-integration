{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "VRM access",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Create a personal access token in the VRM portal under: Preferences → Integrations → Access tokens."
                },
                {
                    "type": "PasswordTextBox",
                    "name": "AccessToken",
                    "caption": "Access token"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Load installations",
                            "onClick": "VRM_LoadInstallations($id);"
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "IdSite",
                    "caption": "Installation",
                    "options": [
                        {
                            "caption": "Please load installations",
                            "value": 0
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Update",
            "expanded": true,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "UpdateInterval",
                    "caption": "Update interval",
                    "suffix": "seconds",
                    "minimum": 15,
                    "maximum": 3600
                },
                {
                    "type": "Label",
                    "caption": "Note: The VRM cloud updates the stored values only every few minutes, so a very short interval does not give faster data."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Value mapping (advanced)",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "The values are detected automatically. If a value stays 0 or is wrong, use 'List available codes', find the correct code(s) and enter them below. Multiple codes are summed (comma separated), e.g. per phase."
                },
                {
                    "type": "Button",
                    "caption": "List available codes",
                    "onClick": "VRM_ListCodes($id);"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodeSOC",
                    "caption": "Code battery charge (SOC)"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodeBatteryVoltage",
                    "caption": "Code battery voltage"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodeBattery",
                    "caption": "Code(s) battery power"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodePV",
                    "caption": "Code(s) solar power"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodeGrid",
                    "caption": "Code(s) grid power (per phase e.g. g1,g2,g3)"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodeConsumption",
                    "caption": "Code(s) AC consumption (per phase e.g. o1,o2,o3)"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CodeDC",
                    "caption": "Code(s) DC loads"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Update now",
            "onClick": "VRM_Update($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Active"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Inactive – please enter access token and select an installation"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Communication error with the VRM API"
        }
    ]
}
